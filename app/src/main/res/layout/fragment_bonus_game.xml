<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.bonusGame.BonusGameFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottom_guide_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.8416" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/top_guide_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="50dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/start_guide_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.08" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/end_guide_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.92" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/button_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/field_button_background_radius_5"
        app:layout_constraintStart_toStartOf="@id/start_guide_line"
        app:layout_constraintTop_toTopOf="@id/top_guide_line">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:background="@drawable/field_black_background_radius_5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/image_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cards_list"
        android:layout_width="256.5dp"
        android:layout_height="116dp"
        app:layout_constraintBottom_toBottomOf="@id/bottom_guide_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/top_guide_line"
        app:layout_constraintVertical_bias="0.7131"
        tools:listitem="@layout/item_card" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/text_win_by_choosing_color"
        app:layout_constraintEnd_toStartOf="@id/win_by_choosing_color"
        android:src="@drawable/image_x2"
        android:layout_marginBottom="2dp"
        android:layout_marginEnd="7dp"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/win_by_choosing_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/top_guide_line"
        app:layout_constraintBottom_toTopOf="@id/text_win_by_choosing_color"
        app:layout_constraintStart_toStartOf="@id/text_win_by_choosing_color"
        app:layout_constraintEnd_toEndOf="@id/text_win_by_choosing_color"
        app:layout_constraintVertical_chainStyle="packed"
        android:textAppearance="@style/All_round_gothic_w01.12sp.Toad_in_love_color" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_win_by_choosing_color"
        android:layout_width="104dp"
        android:layout_height="25dp"
        app:layout_constraintTop_toBottomOf="@id/win_by_choosing_color"
        app:layout_constraintStart_toStartOf="@id/start_guide_line"
        app:layout_constraintBottom_toTopOf="@id/cards_list"
        app:layout_constraintEnd_toEndOf="@id/end_guide_line"
        android:textAppearance="@style/All_round_gothic_w01.10sp.White"
        android:text="Win by Choosing Colour"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintHorizontal_chainStyle="packed"
        android:background="@drawable/bonus_game_numbers_back"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cards_back_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/cards_list"
        app:layout_constraintBottom_toBottomOf="@id/cards_list"
        app:layout_constraintStart_toStartOf="@id/cards_list"
        app:layout_constraintEnd_toEndOf="@id/cards_list"
        android:clickable="true"
        android:focusable="true" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/button_take"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:src="@drawable/image_button_take_pressed"
        app:layout_constraintBottom_toBottomOf="@id/bottom_guide_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/top_guide_line"
        app:layout_constraintStart_toEndOf="@id/layout_button_black"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintVertical_bias="0.5686" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_button_red"
        android:layout_width="81dp"
        android:layout_height="32dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/choose_card_color_back"
        android:padding="1dp"
        app:layout_constraintBottom_toBottomOf="@id/cards_list"
        app:layout_constraintEnd_toStartOf="@id/cards_list"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_red"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/choose_card_red_gradient"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:gravity="center"
            android:textAppearance="@style/All_round_gothic_w01.15sp.White"
            android:text="@string/red"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_button_black"
        android:layout_width="81dp"
        android:layout_height="32dp"
        android:layout_marginStart="7dp"
        android:background="@drawable/choose_card_color_back"
        android:padding="1dp"
        app:layout_constraintBottom_toBottomOf="@id/cards_list"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/cards_list">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_black"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/choose_card_black_gradient"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:gravity="center"
            android:textAppearance="@style/All_round_gothic_w01.15sp.White"
            android:text="@string/black"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/animation_win_layout"
        android:layout_width="180dp"
        android:layout_height="180dp"
        app:layout_constraintTop_toTopOf="@id/win_by_choosing_color"
        app:layout_constraintBottom_toBottomOf="@id/win_by_choosing_color"
        app:layout_constraintStart_toStartOf="@id/win_by_choosing_color"
        app:layout_constraintEnd_toEndOf="@id/win_by_choosing_color"
        android:visibility="gone">

        <ImageView
            android:id="@+id/anim_win"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/animation_loss_layout"
        android:layout_width="180dp"
        android:layout_height="180dp"
        app:layout_constraintTop_toTopOf="@id/win_by_choosing_color"
        app:layout_constraintBottom_toBottomOf="@id/win_by_choosing_color"
        app:layout_constraintStart_toStartOf="@id/win_by_choosing_color"
        app:layout_constraintEnd_toEndOf="@id/win_by_choosing_color"
        android:visibility="gone">

        <ImageView
            android:id="@+id/anim_loss"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>